---
import Layout from '~/layouts/PageLayout.astro';
import SectionLabel from '~/components/ui/SectionLabel.astro';
import TerminalCTA from '~/components/ui/TerminalCTA.astro';
import ASCIIRule from '~/components/ui/ASCIIRule.astro';
import { roles, education, certifications } from '~/data/experience';

const metadata = {
  title: 'Experience',
  description: 'Career history, education, and certifications.',
};
---

<!--
  /experience — career timeline + education + certifications.
  Source of truth is src/data/experience.ts — keep that file in sync with the resume.
-->
<Layout metadata={metadata}>
  <!-- Page header -->
  <section class="mx-auto max-w-5xl px-4 pt-12 pb-8 sm:px-6 md:pt-20 md:pb-12 lg:px-8">
    <SectionLabel text="experience" class="mb-6" />
    <h1 class="mb-4 text-3xl font-bold leading-tight text-ink sm:text-4xl md:text-5xl">Where I've worked.</h1>
    <p class="max-w-2xl text-base text-ink-2 sm:text-lg">
      A short career timeline. For the longer paper trail (formatted nicely),
      <a
        class="underline underline-offset-4 hover:text-ink-2"
        href="/resume.pdf"
        target="_blank"
        rel="noopener noreferrer"
      >
        grab the resume PDF
      </a>.
    </p>
  </section>

  <ASCIIRule />

  <!-- Career roles -->
  <section class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
    <ol class="space-y-10 sm:space-y-12">
      {
        roles.map((role) => (
          <li class="border border-rule p-6 transition-colors hover:border-ink sm:p-8">
            <p class="mb-3 font-mono text-xs text-ink-3">
              {role.start} — {role.end}
            </p>
            <h2 class="mb-1 text-xl font-semibold leading-tight text-ink sm:text-2xl">{role.title}</h2>
            <p class="mb-5 text-sm text-ink-2 sm:text-base">
              {role.company} <span class="text-ink-3">·</span> {role.location}
            </p>
            <ul class="space-y-2 text-sm leading-relaxed text-ink sm:text-base">
              {role.bullets.map((b) => (
                <li class="flex gap-3">
                  <span aria-hidden="true" class="select-none font-mono text-ink-3">
                    ·
                  </span>
                  <span>{b}</span>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>
  </section>

  <ASCIIRule />

  <!-- Education -->
  <section class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
    <SectionLabel text="education" class="mb-6" />
    <ul class="space-y-6">
      {
        education.map((e) => (
          <li>
            <p class="mb-1 font-mono text-xs text-ink-3">
              {e.start} — {e.end}
            </p>
            <h3 class="mb-1 text-lg font-semibold text-ink sm:text-xl">{e.degree}</h3>
            <p class="mb-3 text-sm text-ink-2 sm:text-base">
              {e.institution} <span class="text-ink-3">·</span> {e.location}
            </p>
            {e.coursework && e.coursework.length > 0 && (
              <p class="text-sm text-ink-2">
                <span class="font-mono text-ink-3">coursework:</span> {e.coursework.join(' · ')}
              </p>
            )}
          </li>
        ))
      }
    </ul>
  </section>

  <ASCIIRule />

  <!-- Certifications -->
  <section class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
    <SectionLabel text="certifications" class="mb-6" />
    <ul class="space-y-3 text-base leading-relaxed text-ink sm:text-lg">
      {
        certifications.map((c) => (
          <li class="flex gap-3">
            <span aria-hidden="true" class="select-none font-mono text-ink-3">
              ·
            </span>
            <span>
              {c.name} <span class="text-ink-3">·</span> <span class="text-ink-2">{c.issuer}</span>
            </span>
          </li>
        ))
      }
    </ul>
  </section>

  <ASCIIRule />

  <!-- Final CTA -->
  <section class="mx-auto max-w-5xl px-4 pb-16 sm:px-6 md:pb-24 lg:px-8">
    <SectionLabel text="contact" class="mb-6" />
    <div class="max-w-2xl">
      <h2 class="mb-6 text-2xl font-bold leading-tight text-ink sm:text-3xl">Want to work together?</h2>
      <p class="mb-8 text-base leading-relaxed text-ink-2 sm:text-lg">
        I'm open to software engineering roles — DevOps, infrastructure, or backend — and freelance work. Easiest ways
        to reach me:
      </p>
      <div class="flex flex-wrap gap-x-8 gap-y-3">
        <TerminalCTA href="mailto:jefferyasamani7@gmail.com" text="email-me" />
        <TerminalCTA href="/resume.pdf" text="resume.pdf" target="_blank" />
      </div>
    </div>
  </section>
</Layout>
