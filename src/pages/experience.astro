---
import { Icon } from 'astro-icon/components';

import Layout from '~/layouts/PageLayout.astro';
import SectionLabel from '~/components/ui/SectionLabel.astro';
import TerminalCTA from '~/components/ui/TerminalCTA.astro';
import ASCIIRule from '~/components/ui/ASCIIRule.astro';
import { roles, skills, education, certifications } from '~/data/experience';
import { resolveStackIcon } from '~/data/stack-icons';

const metadata = {
  title: 'Experience',
  description: 'Career history, skills, education, and certifications.',
};

const resolvedSkills = skills.map((cat) => ({
  label: cat.label,
  items: cat.items.map((it) => ({ slug: it.slug, learning: it.learning ?? false, ...resolveStackIcon(it.slug) })),
}));
---

<Layout metadata={metadata}>
  <section class="mx-auto max-w-5xl px-4 pt-8 pb-8 sm:px-6 md:pt-12 md:pb-12 lg:px-8">
    <SectionLabel text="experience" class="reveal mb-6" />
    <h1 class="reveal mb-4 text-3xl font-bold leading-tight text-ink sm:text-4xl md:text-5xl" style="--delay:0.08s">
      Where I've worked.
    </h1>
    <p class="reveal max-w-2xl text-base text-ink-2 sm:text-lg" style="--delay:0.16s">
      A short career timeline, the stack i work with, and a couple of credentials. For the formatted-PDF version,
      <a
        class="underline underline-offset-4 hover:text-ink-2"
        href="/resume.pdf"
        target="_blank"
        rel="noopener noreferrer">grab the resume</a
      >.
    </p>
  </section>

  <ASCIIRule />

  <section class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
    <ol class="space-y-10 sm:space-y-12">
      {
        roles.map((role, i) => (
          <li
            class="reveal border border-rule p-6 transition-colors hover:border-ink sm:p-8"
            style={`--delay:${0.06 * i}s`}
          >
            <p class="mb-3 font-mono text-xs text-ink-3">
              {role.start} — {role.end}
            </p>
            <h2 class="mb-1 text-xl font-semibold leading-tight text-ink sm:text-2xl">{role.title}</h2>
            <p class="mb-5 text-sm text-ink-2 sm:text-base">
              {role.company}
              {role.location && (
                <>
                  {' '}
                  <span class="text-ink-3">·</span> {role.location}
                </>
              )}
            </p>
            {role.bullets.length > 0 && (
              <ul class="space-y-2 text-sm leading-relaxed text-ink sm:text-base">
                {role.bullets.map((b) => (
                  <li class="flex gap-3">
                    <span aria-hidden="true" class="select-none font-mono text-ink-3">
                      ·
                    </span>
                    <span>{b}</span>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
    </ol>
  </section>

  <ASCIIRule />

  <section class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
    <SectionLabel text="skills" class="mb-8" />
    <dl class="space-y-6 sm:space-y-8">
      {
        resolvedSkills.map((cat) => (
          <div class="grid grid-cols-1 gap-3 sm:grid-cols-[minmax(0,200px)_minmax(0,1fr)] sm:items-center sm:gap-6">
            <dt class="font-mono text-xs uppercase tracking-[0.1em] text-ink-2">{cat.label}</dt>
            <dd>
              <ul class="flex flex-wrap items-center gap-x-5 gap-y-3 text-ink-2">
                {cat.items.map((item) => (
                  <li
                    class="inline-flex items-center gap-2 transition-colors hover:text-ink"
                    aria-label={item.label}
                    title={item.label}
                  >
                    {item.iconName ? (
                      <Icon name={item.iconName} class="h-5 w-5" aria-hidden="true" />
                    ) : (
                      <span class="font-mono text-xs text-ink-3">[ {item.label.toLowerCase()} ]</span>
                    )}
                    {item.learning && <span class="font-mono text-xs text-ink-3">(learning)</span>}
                  </li>
                ))}
              </ul>
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  <ASCIIRule />

  <section class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
    <SectionLabel text="education" class="mb-6" />
    <ul class="space-y-6">
      {
        education.map((e) => (
          <li>
            <p class="mb-1 font-mono text-xs text-ink-3">
              {e.start} — {e.end}
            </p>
            <h3 class="mb-1 text-lg font-semibold text-ink sm:text-xl">{e.degree}</h3>
            <p class="mb-3 text-sm text-ink-2 sm:text-base">
              {e.institution} <span class="text-ink-3">·</span> {e.location}
            </p>
            {e.coursework && e.coursework.length > 0 && (
              <p class="text-sm text-ink-2">
                <span class="font-mono text-ink-3">coursework:</span> {e.coursework.join(' · ')}
              </p>
            )}
          </li>
        ))
      }
    </ul>
  </section>

  <ASCIIRule />

  <section class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
    <SectionLabel text="certifications" class="mb-6" />
    <ul class="space-y-3 text-base leading-relaxed text-ink sm:text-lg">
      {
        certifications.map((c) => (
          <li class="flex gap-3">
            <span aria-hidden="true" class="select-none font-mono text-ink-3">
              ·
            </span>
            <span>
              {c.name} <span class="text-ink-3">·</span> <span class="text-ink-2">{c.issuer}</span>
            </span>
          </li>
        ))
      }
    </ul>
  </section>

  <ASCIIRule />

  <section class="mx-auto max-w-5xl px-4 pb-16 sm:px-6 md:pb-24 lg:px-8">
    <SectionLabel text="contact" class="mb-6" />
    <div class="max-w-2xl">
      <h2 class="mb-6 text-2xl font-bold leading-tight text-ink sm:text-3xl">Want to work together?</h2>
      <p class="mb-8 text-base leading-relaxed text-ink-2 sm:text-lg">
        I'm open to software engineering roles — DevOps, infrastructure, or backend — and freelance work.
      </p>
      <div class="flex flex-wrap gap-x-8 gap-y-3">
        <TerminalCTA href="mailto:jefferyasamani7@gmail.com" text="email-me" />
        <TerminalCTA href="/resume.pdf" text="resume.pdf" target="_blank" />
      </div>
    </div>
  </section>
</Layout>
