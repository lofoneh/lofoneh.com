---
import { Icon } from 'astro-icon/components';

import Layout from '~/layouts/PageLayout.astro';
import SectionLabel from '~/components/ui/SectionLabel.astro';
import TerminalCTA from '~/components/ui/TerminalCTA.astro';
import ASCIIRule from '~/components/ui/ASCIIRule.astro';

import { stackCategories, lookingFor } from '~/data/about';
import { resolveStackIcon } from '~/data/stack-icons';

const metadata = {
  title: 'About',
  description: 'About Jeffery Lofoneh Asamani — backend engineer building reliable systems.',
};

// Resolve each stack item to its icon + display label up-front so the template stays clean.
const resolvedStack = stackCategories.map((cat) => ({
  label: cat.label,
  items: cat.items.map((it) => ({
    slug: it.slug,
    learning: it.learning ?? false,
    ...resolveStackIcon(it.slug),
  })),
}));
---

<!--
  /about — long-form bio, headshot slot, current stack, what I'm looking for,
  contact links. All placeholder copy is marked TODO for phase 8.
-->
<Layout metadata={metadata}>
  <!-- Page header -->
  <section class="mx-auto max-w-5xl px-4 pt-12 pb-8 sm:px-6 md:pt-20 md:pb-12 lg:px-8">
    <SectionLabel text="about" class="mb-6" />
    <h1 class="text-3xl font-bold leading-tight text-ink sm:text-4xl md:text-5xl">About me.</h1>
  </section>

  <ASCIIRule />

  <!-- Bio + headshot -->
  <section class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-[minmax(0,1fr)_minmax(220px,280px)] md:items-start md:gap-12">
      <div class="order-2 space-y-5 text-base leading-relaxed text-ink sm:text-lg md:order-1">
        {/* TODO (phase 8): replace these placeholder paragraphs with the real bio. */}
        <p>Hi, I'm Jeffery.</p>
        <p>
          I'm a backend engineer working on reliable data systems and developer tooling. I care about clear code, honest
          documentation, and shipping things that actually work — not just things that look good in a demo.
        </p>
        <p>
          Most of what I build lives in the boring, important layers of a product: ingestion pipelines that don't drop
          data, internal CLIs that make platform work less painful, services that don't wake anyone up at 3am.
        </p>
        <p>
          I'm currently learning Rust in the open and exploring Pulumi for greenfield infra work. When something breaks,
          I want to know why — not just route around it.
        </p>
      </div>

      <div class="order-1 md:order-2">
        {
          /*
          Headshot slot.
          TODO (phase 8): drop a real square or 4:5 portrait at
          src/assets/images/headshot.jpg and replace this placeholder div with:

          <Image
            src={import('~/assets/images/headshot.jpg')}
            alt="Jeffery Lofoneh Asamani"
            class="aspect-[4/5] w-full grayscale transition-[filter] hover:grayscale-0"
            widths={[300, 600]}
            sizes="(min-width: 768px) 280px, 100vw"
            format="webp"
          />
        */
        }
        <div
          class="flex aspect-[4/5] w-full items-center justify-center border border-rule bg-surface-2 font-mono text-xs text-ink-3"
          role="img"
          aria-label="Headshot placeholder"
        >
          [ headshot ]
        </div>
      </div>
    </div>
  </section>

  <ASCIIRule />

  <!-- Current stack -->
  <section class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
    <SectionLabel text="stack" class="mb-8" />
    <dl class="space-y-6 sm:space-y-8">
      {
        resolvedStack.map((cat) => (
          <div class="grid grid-cols-1 gap-3 sm:grid-cols-[minmax(0,180px)_minmax(0,1fr)] sm:items-center sm:gap-6">
            <dt class="font-mono text-xs uppercase tracking-[0.1em] text-ink-2">{cat.label}</dt>
            <dd>
              <ul class="flex flex-wrap items-center gap-x-5 gap-y-3 text-ink-2">
                {cat.items.map((item) => (
                  <li
                    class="inline-flex items-center gap-2 transition-colors hover:text-ink"
                    aria-label={item.label}
                    title={item.label}
                  >
                    {item.iconName ? (
                      <Icon name={item.iconName} class="h-5 w-5" aria-hidden="true" />
                    ) : (
                      <span class="font-mono text-xs text-ink-3">[ {item.slug} ]</span>
                    )}
                    {item.learning && <span class="font-mono text-xs text-ink-3">(learning)</span>}
                  </li>
                ))}
              </ul>
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  <ASCIIRule />

  <!-- What I'm looking for -->
  <section class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
    <SectionLabel text="looking-for" class="mb-6" />
    <ul class="space-y-3 text-base leading-relaxed text-ink sm:text-lg">
      {
        lookingFor.map((item) => (
          <li class="flex gap-3">
            <span aria-hidden="true" class="select-none font-mono text-ink-3">
              ·
            </span>
            <span>{item}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <ASCIIRule />

  <!-- Contact -->
  <section class="mx-auto max-w-3xl px-4 pb-16 sm:px-6 md:pb-24 lg:px-8">
    <SectionLabel text="contact" class="mb-6" />
    <h2 class="mb-6 text-2xl font-bold leading-tight text-ink sm:text-3xl">Easiest ways to reach me.</h2>
    <div class="flex flex-wrap gap-x-8 gap-y-3">
      <TerminalCTA href="mailto:jefferyasamani7@gmail.com" text="email-me" />
      <TerminalCTA href="/resume.pdf" text="resume.pdf" target="_blank" />
      <TerminalCTA href="https://github.com/lofoneh" text="github" target="_blank" />
      <TerminalCTA href="https://x.com/lofoneh" text="x" target="_blank" />
      <TerminalCTA href="https://www.linkedin.com/in/jeffery-asamani/" text="linkedin" target="_blank" />
    </div>
  </section>
</Layout>
