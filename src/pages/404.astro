---
import Layout from '~/layouts/PageLayout.astro';
import SectionLabel from '~/components/ui/SectionLabel.astro';
import TerminalCTA from '~/components/ui/TerminalCTA.astro';
---

<Layout metadata={{ title: 'Page not found', ignoreTitleTemplate: false }}>
  <section class="mx-auto max-w-3xl px-4 py-24 sm:px-6 md:py-32 lg:px-8">
    <SectionLabel text="404" class="mb-6" />
    <h1 class="mb-6 text-4xl font-bold leading-[1.05] tracking-tight text-ink sm:text-5xl md:text-6xl">
      Page not found.
    </h1>
    <p class="mb-12 text-base leading-relaxed text-ink-2 sm:text-lg">
      The URL you tried doesn't exist on this site — either it was never here, or it moved.
    </p>
    <div class="flex flex-wrap items-center gap-x-8 gap-y-3">
      <TerminalCTA href="/" text="back-home" />
      <TerminalCTA href="/projects" text="view-projects" />
    </div>
  </section>
</Layout>
