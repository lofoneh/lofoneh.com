---
import Layout from '~/layouts/PageLayout.astro';
import SectionLabel from '~/components/ui/SectionLabel.astro';
import WorkList from '~/components/widgets/WorkList.astro';
import { projects } from '~/data/projects';

const metadata = {
  title: 'Work',
  description: 'Projects I have built — backend systems, developer tooling, infrastructure.',
};
---

<!--
  /work — the full project list.
  Drop new projects into src/data/projects.ts; they will appear here automatically.
-->
<Layout metadata={metadata}>
  <section class="mx-auto max-w-5xl px-4 pt-16 pb-12 sm:px-6 md:pt-24 md:pb-16 lg:px-8">
    <SectionLabel text="work" class="mb-6" />
    <h1 class="mb-4 text-3xl font-bold leading-tight text-ink sm:text-4xl md:text-5xl">Things I have built.</h1>
    <p class="max-w-2xl text-base text-ink-2 sm:text-lg">
      A selection of backend systems, developer tooling, and infrastructure projects. Some are in production, some are
      open source, some are still figuring themselves out.
    </p>
  </section>

  <section class="mx-auto max-w-5xl px-4 pb-24 sm:px-6 md:pb-32 lg:px-8">
    <WorkList projects={projects} />
  </section>
</Layout>
