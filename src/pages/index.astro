---
import Layout from '~/layouts/PageLayout.astro';
import PortfolioHero from '~/components/widgets/PortfolioHero.astro';
import SectionLabel from '~/components/ui/SectionLabel.astro';
import TerminalCTA from '~/components/ui/TerminalCTA.astro';
import ASCIIRule from '~/components/ui/ASCIIRule.astro';
import WorkList from '~/components/widgets/WorkList.astro';

import { featuredProjects } from '~/data/projects';
import { findLatestPosts } from '~/utils/blog';
import { getPermalink } from '~/utils/permalinks';

const featured = featuredProjects(3);
const latestPosts = await findLatestPosts({ count: 3 });

const metadata = {
  title: 'Jeffery Lofoneh Asamani — Backend Engineer',
  ignoreTitleTemplate: true,
};

const formatDate = (d: Date) => d.toISOString().slice(0, 10);
---

<!--
  Home page composition.
  Sections (in order): hero → ~/work teaser (featured projects) → ~/about teaser →
  ~/writing teaser (latest posts) → ~/contact final CTA.
  Each section is its own block with ASCIIRule dividers. Content max-width varies
  by section purpose: 5xl for cards / project lists, 3xl for prose-y sections.
-->
<Layout metadata={metadata}>
  <PortfolioHero />

  <ASCIIRule />

  <!-- ~/work teaser -->
  <section class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
    <SectionLabel text="work" class="mb-8" />
    <WorkList projects={featured} columns={1} />
    <div class="mt-10">
      <TerminalCTA href="/work" text="see-all-work" />
    </div>
  </section>

  <ASCIIRule />

  <!-- ~/about teaser -->
  <section class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
    <SectionLabel text="about" class="mb-6" />
    <p class="mb-8 text-base leading-relaxed text-ink sm:text-lg">
      {/* TODO: drop a real 2–4 sentence short bio here in phase 8. */}
      Placeholder short bio — I'm a backend engineer working on reliable data systems and developer tooling. I care about
      clear code, honest documentation, and shipping things that actually work.
    </p>
    <TerminalCTA href="/about" text="more-about-me" />
  </section>

  <ASCIIRule />

  <!-- ~/writing teaser -->
  <section class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
    <SectionLabel text="writing" class="mb-8" />

    {
      latestPosts.length > 0 ? (
        <ul class="divide-y divide-rule border-y border-rule">
          {latestPosts.map((post) => (
            <li>
              <a
                href={getPermalink(post.permalink, 'post')}
                class="group flex flex-col gap-1 py-5 transition-colors hover:bg-surface-2 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6 sm:py-6"
              >
                <span class="text-base text-ink underline-offset-4 group-hover:underline sm:text-lg">{post.title}</span>
                <span class="font-mono text-xs text-ink-3">{formatDate(post.publishDate)}</span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="font-mono text-sm text-ink-3">[ no posts yet — first one is in progress ]</p>
      )
    }

    <div class="mt-10">
      <TerminalCTA href="/writing" text="see-all-writing" />
    </div>
  </section>

  <ASCIIRule />

  <!-- ~/contact final CTA -->
  <section class="mx-auto max-w-3xl px-4 pb-16 sm:px-6 md:pb-24 lg:px-8">
    <SectionLabel text="contact" class="mb-6" />
    <h2 class="mb-6 text-2xl font-bold leading-tight text-ink sm:text-3xl">Want to work together?</h2>
    <p class="mb-8 text-base leading-relaxed text-ink-2 sm:text-lg">
      {/* TODO: tighten this copy when real positioning is settled (phase 8). */}
      I'm open to backend / infra roles and freelance work. Easiest way to reach me:
    </p>
    <div class="flex flex-wrap gap-x-8 gap-y-3">
      <TerminalCTA href="mailto:jefferyasamani7@gmail.com" text="email-me" />
      <TerminalCTA href="/resume.pdf" text="resume.pdf" target="_blank" />
    </div>
  </section>
</Layout>
