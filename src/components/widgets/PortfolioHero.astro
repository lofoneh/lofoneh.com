---
import TerminalCTA from '~/components/ui/TerminalCTA.astro';

export interface Props {
  email?: string;
  name?: string;
  tagline?: string;
  primaryCTA?: { href: string; text: string };
  secondaryCTA?: { href: string; text: string };
}

const {
  email = 'jeffery@lofoneh.com',
  name = 'Jeffery Lofoneh Asamani',
  tagline = 'Software engineer. Currently doing DevOps at Adaptive Computer Solutions — CI/CD, Kubernetes, observability.',
  primaryCTA = { href: '/projects', text: 'view-projects' },
  secondaryCTA = { href: '/writing', text: 'read-writing' },
} = Astro.props;
---

<!--
  Home page hero. Email ID line on top (mono), big name, single-sentence tagline,
  two terminal CTAs. Default props give a working hero with zero config; pass
  overrides if reusing elsewhere later.
-->
<section class="mx-auto max-w-5xl px-4 pt-12 pb-16 sm:px-6 md:pt-20 md:pb-24 lg:px-8 lg:pt-28 lg:pb-32">
  <p class="mb-8 font-mono text-sm text-ink-2">~ {email}</p>

  <h1 class="mb-6 text-4xl font-bold leading-[1.05] tracking-tight text-ink sm:text-5xl md:text-6xl lg:text-7xl">
    {name}.
  </h1>

  <p class="mb-12 max-w-2xl text-lg leading-relaxed text-ink-2 md:text-xl">
    {tagline}
  </p>

  <div class="flex flex-wrap items-center gap-x-8 gap-y-3">
    {primaryCTA && <TerminalCTA href={primaryCTA.href} text={primaryCTA.text} />}
    {secondaryCTA && <TerminalCTA href={secondaryCTA.href} text={secondaryCTA.text} />}
  </div>
</section>
