---
interface SocialLink {
  text: string;
  href: string;
}

export interface Props {
  socialLinks?: Array<SocialLink>;
  tagline?: string;
  footNote?: string;
}

const { socialLinks = [], tagline = '', footNote = '' } = Astro.props;
---

<!--
  Minimal text-link footer in the bennett-eghan.com style.
  Layout:
    find me
    github / linkedin / x / email / rss

    tagline (small, mono)
    © year | name
-->
<footer class="relative border-t border-rule">
  <div class="mx-auto flex max-w-6xl flex-col gap-8 px-4 py-12 sm:px-6 md:px-8">
    {
      socialLinks.length > 0 && (
        <div>
          <p class="mb-3 font-mono text-xs uppercase tracking-[0.1em] text-ink-2">find me</p>
          <ul class="flex flex-wrap items-center gap-x-1 gap-y-2 font-mono text-sm text-ink">
            {socialLinks.map((link, i) => (
              <li class="flex items-center gap-1">
                {i > 0 && (
                  <span aria-hidden="true" class="text-ink-3">
                    /
                  </span>
                )}
                <a
                  class="underline-offset-[6px] decoration-1 transition-colors hover:text-ink-2 hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-ink focus-visible:ring-offset-2 focus-visible:ring-offset-surface"
                  href={link.href}
                  {...(link.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                >
                  {link.text}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    {
      (tagline || footNote) && (
        <div class="space-y-1 font-mono text-xs leading-relaxed text-ink-3">
          {tagline && <p>{tagline}</p>}
          {footNote && <p>{footNote}</p>}
        </div>
      )
    }
  </div>
</footer>
