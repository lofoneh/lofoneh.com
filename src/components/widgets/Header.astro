---
import Logo from '~/components/Logo.astro';
import ToggleTheme from '~/components/common/ToggleTheme.astro';
import ToggleMenu from '~/components/common/ToggleMenu.astro';
import Button from '~/components/ui/Button.astro';

import { getHomePermalink, trimSlash } from '~/utils/permalinks';
import type { CallToAction } from '~/types';

interface Link {
  text?: string;
  href?: string;
}

export interface Props {
  id?: string;
  links?: Array<Link>;
  actions?: Array<CallToAction>;
  isSticky?: boolean;
  showToggleTheme?: boolean;
}

const { id = 'header', links = [], actions = [], isSticky = false, showToggleTheme = false } = Astro.props;

const currentPath = `/${trimSlash(new URL(Astro.url).pathname)}`;
---

<!--
  Portfolio header — three-slot layout to play nice with BasicScripts.astro mobile menu logic.
  Slot 1: brand + hamburger toggle (always visible on mobile)
  Slot 2: <nav>          (hidden on mobile; revealed when menu expanded; always shown on md+)
  Slot 3: actions + toggle (hidden on mobile; revealed when menu expanded; always shown on md+)

  BasicScripts toggles `#header nav` and `#header > div > div:last-child` `.hidden` classes
  on the hamburger click. Do not break that structure without updating the script too.
-->
<header
  class:list={[
    { sticky: isSticky, relative: !isSticky },
    'top-0 z-40 mx-auto w-full flex-none transition-[opacity] ease-in-out',
  ]}
  {...isSticky ? { 'data-aw-sticky-header': true } : {}}
  {...id ? { id } : {}}
>
  <div class="absolute inset-0"></div>
  <div class="relative mx-auto flex w-full max-w-6xl flex-wrap items-center justify-between px-4 py-4 sm:px-6 md:px-8">
    <!-- Slot 1: brand + mobile hamburger -->
    <div class="flex items-center justify-between">
      <a class="flex items-center" href={getHomePermalink()} aria-label="Home">
        <Logo />
      </a>
      <div class="md:hidden">
        <ToggleMenu class="-mr-2 flex h-10 w-10 cursor-pointer flex-col items-center justify-center" />
      </div>
    </div>

    <!-- Slot 2: nav -->
    <nav
      class="hidden w-full overflow-y-auto py-4 text-base md:flex md:w-auto md:items-center md:py-0 md:text-sm"
      aria-label="Main navigation"
    >
      <ul class="flex flex-col gap-1 md:flex-row md:items-center">
        {
          links.map(({ text, href }) => (
            <li>
              <a
                class:list={[
                  'block px-3 py-3 text-ink-2 transition-colors hover:text-ink md:py-2',
                  { 'aw-link-active': href === currentPath },
                ]}
                href={href}
              >
                {text}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Slot 3: actions + theme toggle (hidden on mobile until menu opens) -->
    <div class="hidden w-full items-center justify-end gap-2 pb-4 md:flex md:w-auto md:pb-0">
      {showToggleTheme && <ToggleTheme />}
      {actions?.length ? actions.map((btnProps) => <Button {...btnProps} variant="secondary" class="text-sm" />) : null}
    </div>
  </div>
</header>
