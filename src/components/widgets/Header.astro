---
import Logo from '~/components/Logo.astro';
import ToggleTheme from '~/components/common/ToggleTheme.astro';
import ToggleMenu from '~/components/common/ToggleMenu.astro';
import Button from '~/components/ui/Button.astro';

import { getHomePermalink, trimSlash } from '~/utils/permalinks';
import type { CallToAction } from '~/types';

interface Link {
  text?: string;
  href?: string;
}

export interface Props {
  id?: string;
  links?: Array<Link>;
  actions?: Array<CallToAction>;
  isSticky?: boolean;
  showToggleTheme?: boolean;
}

const { id = 'header', links = [], actions = [], isSticky = false, showToggleTheme = false } = Astro.props;

const currentPath = `/${trimSlash(new URL(Astro.url).pathname)}`;
---

<!--
  Portfolio header — cleaner mobile/desktop split.
  Top row always shows brand + (mobile) hamburger / (desktop) nav + actions.
  A separate mobile panel toggles open below the top row. Closes on link click.
  BasicScripts toggles `.hidden` on [data-aw-mobile-menu].
-->
<header
  class:list={[
    { sticky: isSticky, relative: !isSticky },
    'top-0 z-40 mx-auto w-full flex-none transition-[opacity] ease-in-out',
  ]}
  {...isSticky ? { 'data-aw-sticky-header': true } : {}}
  {...id ? { id } : {}}
>
  <div class="absolute inset-0"></div>
  <div class="relative mx-auto w-full max-w-6xl px-4 sm:px-6 md:px-8">
    <!-- Top row: always visible -->
    <div class="flex h-16 items-center justify-between gap-4 md:h-20">
      <a class="flex items-center" href={getHomePermalink()} aria-label="Home">
        <Logo />
      </a>

      <!-- Desktop nav + actions (md+ only) -->
      <div class="hidden items-center gap-6 md:flex">
        <nav aria-label="Main navigation">
          <ul class="flex items-center gap-1 text-sm">
            {
              links.map(({ text, href }) => (
                <li>
                  <a
                    class:list={[
                      'block px-3 py-2 text-ink-2 transition-colors hover:text-ink',
                      { 'aw-link-active': href === currentPath },
                    ]}
                    href={href}
                  >
                    {text}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <div class="flex items-center gap-3">
          {showToggleTheme && <ToggleTheme />}
          {
            actions?.length
              ? actions.map((btnProps) => <Button {...btnProps} variant="secondary" class="text-sm" />)
              : null
          }
        </div>
      </div>

      <!-- Mobile hamburger (mobile only) -->
      <div class="md:hidden">
        <ToggleMenu class="-mr-2 flex h-10 w-10 cursor-pointer flex-col items-center justify-center" />
      </div>
    </div>

    <!--
      Mobile expanded panel.
      Hidden by default; BasicScripts toggles `hidden` when the hamburger fires.
      Always `md:hidden` so it never shows on desktop, even if the script gets confused.
    -->
    <div class="hidden border-t border-rule pb-6 md:hidden" data-aw-mobile-menu>
      <nav class="pt-2" aria-label="Mobile navigation">
        <ul class="flex flex-col">
          {
            links.map(({ text, href }) => (
              <li>
                <a
                  class:list={[
                    'block py-3 text-base text-ink-2 transition-colors hover:text-ink',
                    { 'aw-link-active': href === currentPath },
                  ]}
                  href={href}
                >
                  {text}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      {
        (showToggleTheme || actions?.length) && (
          <div class="mt-4 flex flex-wrap items-center justify-between gap-3 border-t border-rule pt-4">
            {showToggleTheme && <ToggleTheme />}
            {actions?.length ? (
              <div class="flex flex-wrap gap-2">
                {actions.map((btnProps) => (
                  <Button {...btnProps} variant="secondary" class="text-sm" />
                ))}
              </div>
            ) : null}
          </div>
        )
      }
    </div>
  </div>
</header>
