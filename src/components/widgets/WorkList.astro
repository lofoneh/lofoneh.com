---
import WorkCard from '~/components/ui/WorkCard.astro';
import type { Project } from '~/data/projects';

export interface Props {
  projects: Project[];
  columns?: 1 | 2;
}

const { projects, columns = 2 } = Astro.props;

const gridClass = columns === 1 ? 'grid grid-cols-1 gap-4 sm:gap-6' : 'grid grid-cols-1 gap-4 sm:gap-6 md:grid-cols-2';
---

{
  projects.length > 0 ? (
    <div class={gridClass}>
      {projects.map((project) => (
        <WorkCard project={project} class="reveal-up intersect intersect-once" />
      ))}
    </div>
  ) : (
    <p class="font-mono text-sm text-ink-3">[ no projects yet — check back soon ]</p>
  )
}
