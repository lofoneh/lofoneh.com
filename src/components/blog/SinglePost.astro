---
import Image from '~/components/common/Image.astro';
import PostTags from '~/components/blog/Tags.astro';
import ShareButtons from '~/components/blog/ShareButtons.astro';
import Comments from '~/components/blog/Comments.astro';
import SectionLabel from '~/components/ui/SectionLabel.astro';

import { getPermalink } from '~/utils/permalinks';
import { getFormattedDate } from '~/utils/utils';

import type { Post } from '~/types';

export interface Props {
  post: Post;
  url: string | URL;
}

const { post, url } = Astro.props;
---

<article class="mx-auto max-w-5xl px-4 pb-8 pt-8 sm:px-6 md:pt-12 lg:px-8">
  <header class="mx-auto max-w-2xl">
    <SectionLabel text="writing" class="mb-4" />

    <h1 class="mb-5 text-3xl font-bold leading-tight tracking-tight text-ink sm:text-4xl md:text-5xl">
      {post.title}
    </h1>

    {post.excerpt && <p class="mb-6 text-lg leading-relaxed text-ink-2 sm:text-xl">{post.excerpt}</p>}

    <p class="font-mono text-xs text-ink-3">
      <time datetime={String(post.publishDate)}>{getFormattedDate(post.publishDate)}</time>
      {
        post.author && (
          <>
            <span class="mx-2">·</span>
            <span>{post.author.replaceAll('-', ' ')}</span>
          </>
        )
      }
      {
        post.category && (
          <>
            <span class="mx-2">·</span>
            <a class="transition-colors hover:text-ink" href={getPermalink(post.category.slug, 'category')}>
              {post.category.title.toLowerCase()}
            </a>
          </>
        )
      }
      {
        post.readingTime && (
          <>
            <span class="mx-2">·</span>
            <span>{post.readingTime} min read</span>
          </>
        )
      }
    </p>
  </header>

  {
    post.image && (
      <div class="mx-auto mt-10 max-w-3xl">
        <Image
          src={post.image}
          class="w-full"
          widths={[400, 900]}
          sizes="(max-width: 900px) 400px, 900px"
          alt={post?.excerpt || ''}
          width={900}
          height={506}
          format="webp"
          loading="eager"
          decoding="async"
        />
      </div>
    )
  }

  <div
    class="prose prose-lg mx-auto mt-12 max-w-2xl text-ink prose-headings:font-heading prose-headings:font-semibold prose-headings:text-ink prose-headings:tracking-tight prose-headings:scroll-mt-20 prose-p:text-ink prose-a:text-ink prose-a:underline prose-a:underline-offset-[6px] prose-a:decoration-1 hover:prose-a:text-ink-2 prose-strong:text-ink prose-blockquote:border-l-rule prose-blockquote:text-ink-2 prose-code:text-ink prose-code:font-mono prose-code:before:content-none prose-code:after:content-none prose-pre:bg-surface-2 prose-pre:text-ink prose-pre:border prose-pre:border-rule prose-hr:border-rule prose-li:my-1 dark:prose-invert"
  >
    <slot />
  </div>

  <footer class="mx-auto mt-10 flex max-w-2xl flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
    {post.tags && <PostTags tags={post.tags} />}
    <ShareButtons url={url} title={post.title} />
  </footer>

  <Comments />
</article>
