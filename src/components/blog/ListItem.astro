---
import PostTags from '~/components/blog/Tags.astro';

import { APP_BLOG } from 'astrowind:config';
import type { Post } from '~/types';

import { getPermalink } from '~/utils/permalinks';
import { getFormattedDate } from '~/utils/utils';

export interface Props {
  post: Post;
}

const { post } = Astro.props;

const link = APP_BLOG?.post?.isEnabled ? getPermalink(post.permalink, 'post') : '';
---

<!--
  Blog list entry. Monochrome, text-forward (no hero image cards).
  Layout: mono meta row → title (link) → excerpt → tags.
  Hover: title underlines.
-->
<article class="space-y-3 sm:space-y-4">
  <p class="font-mono text-xs text-ink-3">
    <time datetime={String(post.publishDate)}>{getFormattedDate(post.publishDate)}</time>
    {
      post.category && (
        <>
          <span class="mx-2">·</span>
          <a class="transition-colors hover:text-ink" href={getPermalink(post.category.slug, 'category')}>
            {post.category.title.toLowerCase()}
          </a>
        </>
      )
    }
    {
      post.readingTime && (
        <>
          <span class="mx-2">·</span>
          <span>{post.readingTime} min read</span>
        </>
      )
    }
  </p>

  <h2 class="text-xl font-semibold leading-tight text-ink sm:text-2xl">
    {
      link ? (
        <a class="underline-offset-[6px] decoration-1 transition-colors hover:underline" href={link}>
          {post.title}
        </a>
      ) : (
        post.title
      )
    }
  </h2>

  {post.excerpt && <p class="text-base leading-relaxed text-ink-2 sm:text-lg">{post.excerpt}</p>}

  {post.tags && Array.isArray(post.tags) && post.tags.length > 0 && <PostTags tags={post.tags} />}
</article>
