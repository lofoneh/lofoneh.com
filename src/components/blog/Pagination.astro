---
import { getPermalink } from '~/utils/permalinks';

export interface Props {
  prevUrl?: string;
  nextUrl?: string;
  prevText?: string;
  nextText?: string;
}

const { prevUrl, nextUrl, prevText = 'newer-posts', nextText = 'older-posts' } = Astro.props;
---

<!--
  Monochrome pagination. Two terminal-styled links at the bottom of the list.
  Disabled side is hidden entirely rather than greyed-out (cleaner than a ghost).
-->{
  (prevUrl || nextUrl) && (
    <nav class="mt-12 flex flex-wrap items-center justify-between gap-4 font-mono text-sm">
      {prevUrl ? (
        <a
          class="group inline-flex items-baseline gap-1 text-ink no-underline transition-colors hover:text-ink-2 focus:outline-none focus-visible:ring-2 focus-visible:ring-ink focus-visible:ring-offset-2 focus-visible:ring-offset-surface"
          href={getPermalink(prevUrl)}
        >
          <span aria-hidden="true" class="text-ink-3 group-hover:text-ink">
            ←
          </span>
          <span class="underline-offset-[6px] decoration-1 group-hover:underline">{prevText}</span>
        </a>
      ) : (
        <span aria-hidden="true" />
      )}

      {nextUrl ? (
        <a
          class="group inline-flex items-baseline gap-1 text-ink no-underline transition-colors hover:text-ink-2 focus:outline-none focus-visible:ring-2 focus-visible:ring-ink focus-visible:ring-offset-2 focus-visible:ring-offset-surface"
          href={getPermalink(nextUrl)}
        >
          <span class="underline-offset-[6px] decoration-1 group-hover:underline">{nextText}</span>
          <span aria-hidden="true" class="text-ink-3 group-hover:text-ink">
            →
          </span>
        </a>
      ) : (
        <span aria-hidden="true" />
      )}
    </nav>
  )
}
