---
import { APP_BLOG } from 'astrowind:config';

import { getRelatedPosts } from '~/utils/blog';
import Grid from '~/components/blog/Grid.astro';
import type { Post } from '~/types';

export interface Props {
  post: Post;
}

const { post } = Astro.props;

const relatedPosts = post.tags ? await getRelatedPosts(post, 4) : [];
---

{
  APP_BLOG.isRelatedPostsEnabled && relatedPosts.length > 0 ? (
    <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
      <h2 class="mb-6 font-heading text-3xl font-bold tracking-tight sm:text-4xl">Related posts</h2>
      <Grid posts={relatedPosts} />
    </section>
  ) : null
}
