---
import { APP_BLOG } from 'astrowind:config';
import type { Post } from '~/types';

import { getPermalink } from '~/utils/permalinks';
import { getFormattedDate } from '~/utils/utils';

export interface Props {
  post: Post;
}

const { post } = Astro.props;

const link = APP_BLOG?.post?.isEnabled ? getPermalink(post.permalink, 'post') : '';
---

<!--
  Compact post card used in the RelatedPosts grid.
  Text-forward, no image, mono date, underline-on-hover title.
-->
<article class="border border-rule p-5 transition-colors hover:border-ink sm:p-6">
  <p class="mb-3 font-mono text-xs text-ink-3">
    <time datetime={String(post.publishDate)}>{getFormattedDate(post.publishDate)}</time>
    {
      post.readingTime && (
        <>
          <span class="mx-2">·</span>
          <span>{post.readingTime} min</span>
        </>
      )
    }
  </p>

  <h3 class="text-base font-semibold leading-tight text-ink sm:text-lg">
    {
      link ? (
        <a class="underline-offset-[6px] decoration-1 hover:underline" href={link}>
          {post.title}
        </a>
      ) : (
        post.title
      )
    }
  </h3>

  {post.excerpt && <p class="mt-3 text-sm leading-relaxed text-ink-2">{post.excerpt}</p>}
</article>
