---
import { getBlogPermalink } from '~/utils/permalinks';
---

<!--
  Back-to-writing link rendered at the bottom of every single post.
  Terminal-styled to match the rest of the CTAs.
-->
<div class="mx-auto max-w-5xl px-4 pb-8 pt-12 sm:px-6 lg:px-8">
  <a
    class="group inline-flex items-baseline gap-1 font-mono text-sm text-ink no-underline transition-colors hover:text-ink-2 focus:outline-none focus-visible:ring-2 focus-visible:ring-ink focus-visible:ring-offset-2 focus-visible:ring-offset-surface"
    href={getBlogPermalink()}
  >
    <span aria-hidden="true" class="text-ink-3 group-hover:text-ink">←</span>
    <span class="underline-offset-[6px] decoration-1 group-hover:underline">back-to-writing</span>
  </a>
</div>
