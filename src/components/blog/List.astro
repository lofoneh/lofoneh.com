---
import Item from '~/components/blog/ListItem.astro';
import type { Post } from '~/types';

export interface Props {
  posts: Array<Post>;
}

const { posts } = Astro.props;
---

<!--
  Vertical post list with hairline dividers between entries.
  Tighter spacing than the old design (no big mb-20 gaps).
-->{
  posts.length > 0 ? (
    <ul class="divide-y divide-rule border-y border-rule">
      {posts.map((post) => (
        <li class="py-10 first:pt-0 sm:py-12">
          <Item post={post} />
        </li>
      ))}
    </ul>
  ) : (
    <p class="font-mono text-sm text-ink-3">[ no posts yet — first one is in progress ]</p>
  )
}
