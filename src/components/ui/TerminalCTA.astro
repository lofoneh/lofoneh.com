---
export interface Props {
  href: string;
  text: string;
  target?: string;
  class?: string;
}

const { href, text, target, class: className = '' } = Astro.props;
const externalAttrs = target ? { target, rel: 'noopener noreferrer' } : {};
---

<!--
  Primary CTA in terminal style: $ ./action-name
  Use sparingly — the hero gets one or two of these; nothing else.
  See docs/superpowers/specs/2026-05-24-portfolio-redesign-design.md §4 (Terminal motifs).
-->
<a
  href={href}
  class:list={[
    'group inline-flex items-baseline gap-1 font-mono text-base text-ink no-underline transition-colors',
    'hover:text-ink-2 focus:outline-none focus-visible:ring-2 focus-visible:ring-ink focus-visible:ring-offset-2 focus-visible:ring-offset-surface',
    className,
  ]}
  {...externalAttrs}
>
  <span aria-hidden="true" class="select-none text-ink-3 transition-colors group-hover:text-ink">$</span>
  <span class="underline-offset-[6px] decoration-1 group-hover:underline">./{text}</span>
</a>
