---
import { Icon } from 'astro-icon/components';
import type { Project } from '~/data/projects';
import { resolveStackIcon } from '~/data/stack-icons';

export interface Props {
  project: Project;
  class?: string;
  style?: string;
}

const { project, class: className = '', style } = Astro.props;
const { title, oneLiner, stack, role, year, links, status } = project;

const stackEntries = stack.map((slug) => ({ slug, ...resolveStackIcon(slug) }));

// "shipped" is the default — no status badge; only ongoing/exploring tag in meta row.
const statusTag = status === 'shipped' ? null : status;
---

<article
  class:list={[
    'group flex flex-col gap-5 border border-rule p-6 transition-colors duration-200 hover:border-ink sm:gap-6 sm:p-8',
    className,
  ]}
  style={style}
>
  <p class="font-mono text-xs text-ink-3">
    {year}
    {role && <span class="ml-2">· {role}</span>}
    {statusTag && <span class="ml-2">· {statusTag}</span>}
  </p>

  <h3 class="text-xl font-semibold leading-tight text-ink sm:text-2xl">
    {title}
  </h3>

  <p class="text-sm leading-relaxed text-ink-2 sm:text-base">{oneLiner}</p>

  {
    stackEntries.length > 0 && (
      <ul class="flex flex-wrap items-center gap-x-4 gap-y-2 text-ink-2">
        {stackEntries.map((entry) =>
          entry.iconName ? (
            <li
              class="inline-flex items-center transition-colors hover:text-ink"
              aria-label={entry.label}
              title={entry.label}
            >
              <Icon name={entry.iconName} class="h-5 w-5" aria-hidden="true" />
            </li>
          ) : (
            <li class="font-mono text-xs text-ink-3" title={entry.label}>
              [ {entry.slug} ]
            </li>
          )
        )}
      </ul>
    )
  }

  {
    (links.live || links.repo || links.docs) && (
      <div class="flex flex-wrap gap-x-6 gap-y-2 font-mono text-sm">
        {links.live && (
          <a
            class="group/link inline-flex items-baseline gap-1 text-ink no-underline transition-colors hover:text-ink-2 focus:outline-none focus-visible:ring-2 focus-visible:ring-ink focus-visible:ring-offset-2 focus-visible:ring-offset-surface"
            href={links.live}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span aria-hidden="true" class="text-ink-3 group-hover/link:text-ink">
              $
            </span>
            <span class="underline-offset-[6px] decoration-1 group-hover/link:underline">./live</span>
          </a>
        )}
        {links.repo && (
          <a
            class="group/link inline-flex items-baseline gap-1 text-ink no-underline transition-colors hover:text-ink-2 focus:outline-none focus-visible:ring-2 focus-visible:ring-ink focus-visible:ring-offset-2 focus-visible:ring-offset-surface"
            href={links.repo}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span aria-hidden="true" class="text-ink-3 group-hover/link:text-ink">
              $
            </span>
            <span class="underline-offset-[6px] decoration-1 group-hover/link:underline">./repo</span>
          </a>
        )}
        {links.docs && (
          <a
            class="group/link inline-flex items-baseline gap-1 text-ink no-underline transition-colors hover:text-ink-2 focus:outline-none focus-visible:ring-2 focus-visible:ring-ink focus-visible:ring-offset-2 focus-visible:ring-offset-surface"
            href={links.docs}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span aria-hidden="true" class="text-ink-3 group-hover/link:text-ink">
              $
            </span>
            <span class="underline-offset-[6px] decoration-1 group-hover/link:underline">./docs</span>
          </a>
        )}
      </div>
    )
  }
</article>
