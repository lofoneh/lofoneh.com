---
import type { HTMLTag } from 'astro/types';
import type { Widget } from '~/types';
import { twMerge } from 'tailwind-merge';

export interface Props extends Widget {
  containerClass?: string;
  ['as']?: HTMLTag;
}

const { id, containerClass = '', as = 'section' } = Astro.props;

const WrapperTag = as;
---

<WrapperTag class="relative scroll-mt-20" {...id ? { id } : {}}>
  <div
    class:list={[
      twMerge(
        'mx-auto max-w-5xl px-4 py-16 sm:px-6 md:py-20 lg:px-8 lg:py-24 intersect-once intersect-quarter intersect-no-queue motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade',
        containerClass
      ),
    ]}
  >
    <slot />
  </div>
</WrapperTag>
