---
import SectionLabel from '~/components/ui/SectionLabel.astro';
import SectionHeader from '~/components/ui/SectionHeader.astro';
import SectionBody from '~/components/ui/SectionBody.astro';
import { roles, skills, education, certifications } from '~/data/experience';

const formatDate = (role: { start: string; end: string }) =>
  `${role.start} — ${role.end === 'Present' ? 'now' : role.end}`.toLowerCase();

const edu = education[0];
const certLine = [
  ...certifications.map((c) => c.name),
  `${edu.degree}, ${edu.institution.match(/\(([^)]+)\)/)?.[1] ?? edu.institution} (${edu.start.slice(-4)}–${edu.end.slice(-4)})`,
].join(' · ');
---

<section class="mx-auto max-w-5xl px-4 pt-8 pb-12 sm:px-6 md:pt-12 md:pb-16 lg:px-8">
  <SectionHeader index="03" label="experience" title="Where I've worked.">
    A short career timeline, the stack i work with, and a couple of credentials. For the formatted-PDF version,
    <a
      class="underline underline-offset-4 hover:text-ink-2"
      href="/resume.pdf"
      target="_blank"
      rel="noopener noreferrer">grab the resume</a
    >.
  </SectionHeader>

  <SectionBody class="mt-10">
    <ol class="border-t border-rule">
      {
        roles.map((role) => (
          <li class="reveal-up intersect intersect-once grid gap-1 border-b border-rule py-6 sm:grid-cols-[9rem_minmax(0,1fr)] sm:gap-6">
            <p class="font-mono text-xs text-ink-3">{formatDate(role)}</p>
            <div class="min-w-0">
              <h3 class="font-semibold leading-tight text-ink">{role.title}</h3>
              <p class="mt-1 text-sm text-ink-2">
                {role.company}
                {role.location && (
                  <>
                    {' '}
                    <span class="text-ink-3">·</span> {role.location}
                  </>
                )}
              </p>
              {role.bullets.length > 0 && (
                <ul class="mt-3 space-y-2 text-sm leading-relaxed text-ink">
                  {role.bullets.map((b) => (
                    <li class="flex gap-3">
                      <span aria-hidden="true" class="select-none font-mono text-ink-3">
                        ·
                      </span>
                      <span class="min-w-0">{b}</span>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </li>
        ))
      }
    </ol>

    <div class="reveal-up intersect intersect-once mt-12">
      <SectionLabel text="skills" class="mb-6" />
      <dl class="space-y-5">
        {
          skills.map((cat) => (
            <div class="grid grid-cols-1 gap-2 sm:grid-cols-[minmax(0,12rem)_minmax(0,1fr)] sm:gap-6">
              <dt class="font-mono text-xs uppercase tracking-[0.1em] text-ink-2">{cat.label}</dt>
              <dd class="min-w-0">
                <ul class="flex flex-wrap gap-2">
                  {cat.items.map((item) => (
                    <li class="border border-rule px-2 py-0.5 font-mono text-xs text-ink-2">{item}</li>
                  ))}
                </ul>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div class="reveal-up intersect intersect-once mt-12">
      <SectionLabel text="certs & education" class="mb-4" />
      <p class="text-sm text-ink-2">{certLine}</p>
    </div>
  </SectionBody>
</section>
