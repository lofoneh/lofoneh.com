---
import ActivityPanel from '~/components/ui/ActivityPanel.astro';
import { getPortfolioData } from '~/utils/github';

const { activity } = await getPortfolioData();
---

<section class="mx-auto max-w-5xl px-4 pt-8 pb-16 sm:px-6 md:pt-12 md:pb-20 lg:px-8">
  <div class="border-t border-rule pt-8 sm:pt-10">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)] lg:items-start">
      <div class="min-w-0">
        <p class="font-mono text-sm text-ink-3">
          <span class="select-none" aria-hidden="true">$ </span><span
            class="cmd"
            style="--w:6ch;--steps:6;--delay:0.15s;--dur:0.5s">whoami</span
          >
        </p>

        <h1
          class="reveal mt-3 text-4xl font-bold leading-[1.05] tracking-tight text-ink sm:text-5xl md:text-6xl"
          style="--delay:0.75s"
        >
          hi, i'm jeffery <span aria-hidden="true" class="motion-safe:animate-wave origin-[70%_70%] inline-block"
            >👋</span
          >
        </h1>

        <p class="reveal mt-4 font-mono text-sm text-ink-2" style="--delay:0.9s">
          <span>devops &amp; backend engineer</span><span class="hidden sm:inline"> · </span><br class="sm:hidden" />
          <span>accra, ghana · open to remote</span>
        </p>

        <p class="mt-8 font-mono text-sm text-ink-3">
          <span class="select-none" aria-hidden="true">$ </span><span
            class="cmd"
            style="--w:12ch;--steps:12;--delay:1.05s;--dur:0.6s">cat about.md</span
          >
        </p>

        <div class="mt-4 max-w-2xl space-y-5 text-base leading-relaxed text-ink sm:space-y-6 sm:text-lg">
          <p class="reveal" style="--delay:1.75s">
            i build the parts nobody notices — pipelines, Kubernetes, observability — the unglamorous plumbing that
            keeps everything people use running. lately that means fixing failover bugs in a Kubernetes database
            operator, in public, with tests that prove it.
          </p>

          <p class="reveal" style="--delay:1.95s">
            day-to-day that's DevOps at Adaptive Computer Solutions, keeping production calm and quietly boring. my
            degree is in metallurgical engineering from KNUST; software was a back-door entry i taught myself after
            graduation.
          </p>

          <p class="reveal" style="--delay:2.15s">
            these days i'm deep in Go, Rust and Kubernetes operators. in my downtime: movies, anime, Gospel music, and
            the occasional acoustic guitar.
          </p>
        </div>

        <p class="reveal mt-8 font-mono text-sm text-ink-3" style="--delay:2.55s" aria-hidden="true">
          $ <span class="caret inline-block h-[1.1em] w-[0.55em] translate-y-[0.15em] bg-ink"></span>
        </p>
      </div>

      <ActivityPanel activity={activity} class="reveal" style="--delay:2.35s" />
    </div>
  </div>
</section>

<style>
  /* Typed commands and revealed lines are fully visible by default — only the
     animations below are conditional, so the page reads correctly with motion
     off or JS disabled. */
  .cmd {
    display: inline-block;
    overflow: hidden;
    white-space: nowrap;
    vertical-align: bottom;
  }

  @media (prefers-reduced-motion: no-preference) {
    .cmd {
      width: 0;
      animation: type var(--dur) steps(var(--steps), end) var(--delay) both;
    }

    /* .reveal is global (tailwind.css) — shared with the inner pages. */

    .caret {
      animation: blink 1.1s step-end infinite;
    }

    @keyframes type {
      to {
        width: var(--w);
      }
    }

    @keyframes blink {
      0%,
      50% {
        opacity: 1;
      }
      50.01%,
      100% {
        opacity: 0;
      }
    }
  }
</style>
