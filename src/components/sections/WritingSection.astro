---
import SectionHeader from '~/components/ui/SectionHeader.astro';
import SectionBody from '~/components/ui/SectionBody.astro';
import { APP_BLOG } from 'astrowind:config';
import { findLatestPosts } from '~/utils/blog';
import { getPermalink } from '~/utils/permalinks';
import { getFormattedDate } from '~/utils/utils';

// Show the latest posts inline; each links out to its own /writing/<slug> page.
const posts = await findLatestPosts({ count: 5 });
---

<div class="mx-auto max-w-5xl px-4 pt-8 pb-8 sm:px-6 md:pt-12 md:pb-12 lg:px-8">
  <SectionHeader index="05" label="writing" title="Writing.">
    Notes from work — infrastructure, observability, learning out loud.
  </SectionHeader>
</div>

<div class="mx-auto max-w-5xl px-4 pb-8 sm:px-6 lg:px-8">
  <SectionBody>
    <ul class="reveal-up intersect intersect-once border-t border-rule">
      {
        posts.map((post) => {
          const link = APP_BLOG?.post?.isEnabled ? getPermalink(post.permalink, 'post') : '';
          return (
            <li class="grid gap-1 border-b border-rule py-4 sm:grid-cols-[7rem_minmax(0,1fr)] sm:gap-6">
              <p class="font-mono text-xs text-ink-3">
                <time datetime={post.publishDate.toISOString()}>{getFormattedDate(post.publishDate)}</time>
              </p>
              <h3 class="min-w-0 font-semibold leading-tight text-ink">
                {link ? (
                  <a class="underline-offset-[6px] decoration-1 transition-colors hover:underline" href={link}>
                    {post.title}
                  </a>
                ) : (
                  post.title
                )}
              </h3>
            </li>
          );
        })
      }
    </ul>
  </SectionBody>
</div>
