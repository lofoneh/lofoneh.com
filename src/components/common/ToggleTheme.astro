---
import { UI } from 'astrowind:config';

export interface Props {
  label?: string;
  class?: string;
}

const {
  label = 'Toggle between Dark and Light mode',
  class:
    className = 'inline-flex items-center justify-center px-2 py-1 font-mono text-sm text-ink-2 hover:text-ink transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-ink focus-visible:ring-offset-2 focus-visible:ring-offset-surface',
} = Astro.props;
---

{
  /*
    Renders the OPPOSITE of the current theme — i.e. clicking shows the action,
    not the state. In light mode shows "[dark]"; in dark mode shows "[light]".
    The click handler in BasicScripts.astro listens on [data-aw-toggle-color-scheme].
  */
  !(UI.theme && UI.theme.endsWith(':only')) && (
    <button type="button" class={className} aria-label={label} data-aw-toggle-color-scheme>
      <span class="block dark:hidden">[dark]</span>
      <span class="hidden dark:block">[light]</span>
    </button>
  )
}
