---
/**
 * Vercel Web Analytics + Speed Insights.
 * Both packages ship a small inline script that pings Vercel's edge — no
 * cookies, no PII, GDPR-friendly. Stats only show up once you enable the
 * matching feature in the Vercel project dashboard, but it's safe to ship
 * the scripts before that — they no-op until enabled server-side.
 */
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
---

<Analytics />
<SpeedInsights />
