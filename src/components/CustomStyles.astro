---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
---

<style is:inline>
  /*
    Design tokens — see docs/superpowers/specs/2026-05-24-portfolio-redesign-design.md §4.
    Monochrome, dark-first. `:root` holds light values; `.dark` overrides them.
    `--aw-color-*` aliases keep legacy AstroWind utilities working off the new tokens.
  */

  :root {
    /* Typography */
    --aw-font-sans: 'Geist Variable', ui-sans-serif, system-ui, sans-serif;
    --aw-font-mono: 'Geist Mono Variable', ui-monospace, SFMono-Regular, Menlo, monospace;
    --aw-font-heading: 'Geist Variable', ui-sans-serif, system-ui, sans-serif;
    --aw-font-serif: 'Geist Variable', ui-sans-serif, system-ui, sans-serif;

    /* Monochrome (light mode) */
    --ink: #0a0a0a;
    --ink-2: #52525b;
    --ink-3: #a1a1aa;
    --surface: #fafafa;
    --surface-2: #f4f4f5;
    --rule: #e4e4e7;

    /* Legacy --aw-* aliases — keep old utilities working */
    --aw-color-text-default: var(--ink);
    --aw-color-text-muted: var(--ink-2);
    --aw-color-text-heading: var(--ink);
    --aw-color-bg-page: var(--surface);
    --aw-color-bg-page-dark: var(--surface);
    --aw-color-primary: var(--ink);
    --aw-color-secondary: var(--ink);
    --aw-color-accent: var(--ink);

    ::selection {
      background-color: var(--ink);
      color: var(--surface);
    }
  }

  .dark {
    /* Monochrome (dark mode — default per config.yaml ui.theme) */
    --ink: #fafafa;
    --ink-2: #a1a1aa;
    --ink-3: #52525b;
    --surface: #0a0a0a;
    --surface-2: #171717;
    --rule: #27272a;

    --aw-color-text-default: var(--ink);
    --aw-color-text-muted: var(--ink-2);
    --aw-color-text-heading: var(--ink);
    --aw-color-bg-page: var(--surface);
    --aw-color-bg-page-dark: var(--surface);

    ::selection {
      background-color: var(--ink);
      color: var(--surface);
    }
  }
</style>
